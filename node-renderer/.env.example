# --- server ---
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=

# --- storage ---
DATA_DIR=./data

# --- rendering ---
# local  = render in-process with Remotion (works if the host can run Chromium)
# external = POST scene JSON to a remote renderer (VPS / Remotion Lambda)
RENDER_TARGET=local
RENDER_CONCURRENCY=1
MAX_RENDER_RETRIES=1
# EXTERNAL_RENDER_URL=https://your-vps.example.com/render
# EXTERNAL_RENDER_TOKEN=change-me
# CHROMIUM_PATH=/usr/bin/chromium   # override auto-discovery if needed

# --- LLM (auto-selects the first provider with a key; else offline heuristic) ---
LLM_PROVIDER=auto
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=30000

# --- auth (PHP -> Node shared secret; empty = open) ---
NODE_RENDER_API_TOKEN=
